# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets — never commit
users.json
.env
.env.*
!.env.example
*.pem
*.key
*_sa.json
service-account*.json

# Terraform (module lives at infra/; state and provider cache never commit)
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!*.example.tfvars
# A saved plan is not a summary — it embeds the resolved values of every
# variable, including ones sourced from secrets. It never commits.
*.tfplan

# Captured run output. Regenerate it by running the script that produced it;
# committing it makes stale evidence look current.
artifacts/

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/

# Model weights / datasets
*.safetensors
*.gguf
models/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/.env.local

# Local scratch: downloaded tools, archives, scratch indexes, run logs. None of
# it is an input to a build, and a 190 MB archive in a clone helps nobody.
*.zip
*.exe
*.log
.user_index

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

