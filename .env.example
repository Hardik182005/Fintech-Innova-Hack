# Copy to .env for local development. Never commit .env.
# No real secrets belong in this file even locally; GCP uses Secret Manager.

CREDENCE_RUN_MODE=LOCAL_DEV
CREDENCE_ENVIRONMENT=sandbox
CREDENCE_DATABASE_URL=postgresql+psycopg://credence:credence@localhost:5432/credence
CREDENCE_OPA_URL=http://localhost:8181

# Local AI via Ollama (no API keys; fully local inference)
CREDENCE_MODEL_PROVIDER=ollama            # ollama | disabled
CREDENCE_OLLAMA_BASE_URL=http://localhost:11434
# One GPU serves every role from a single loaded tag. These must be the exact
# tag the inference container verifies at startup — a shortened or invented tag
# is a 404 from Ollama at request time, not a startup error.
CREDENCE_OLLAMA_ANALYST_MODEL=mistral-small3.2:24b-instruct-2506-q4_K_M
CREDENCE_OLLAMA_CRITIC_MODEL=mistral-small3.2:24b-instruct-2506-q4_K_M
CREDENCE_MODEL_TIMEOUT_SECONDS=120

# Page assistant orb (frontend). Unset CREDENCE_ORB_OLLAMA_URL and the orb still
# answers from the page's own stated facts — which is how it ships to the GCP
# sandbox, because the GPU there holds one loaded model and scales to zero, so
# pointing the orb at it would evict the analyst model and put a ~350s cold
# start in front of somebody typing "hi".
CREDENCE_ORB_OLLAMA_URL=http://localhost:11434
CREDENCE_ORB_MODEL=gemma3:4b

# Demo endpoints bearer token (sandbox only)
CREDENCE_DEMO_RESET_TOKEN=change-me
# Second credential for the destructive reset. Never give this to the web tier:
# it attaches the demo token to demo requests on any visitor's behalf, so the
# demo token alone cannot be what stands between a browser and drop_all().
CREDENCE_DEMO_ADMIN_TOKEN=

# Voice stays disabled unless explicitly configured
CREDENCE_VOICE_PROVIDER=disabled
# ELEVENLABS_API_KEY=

# GCP context (no keys — gcloud ADC / Workload Identity only)
GOOGLE_CLOUD_PROJECT=innova-hack
GOOGLE_CLOUD_REGION=asia-south1
