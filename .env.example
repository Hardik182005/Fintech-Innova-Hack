# Copy to .env for local development. Never commit .env.
# No real secrets belong in this file even locally; GCP uses Secret Manager.

CREDENCE_RUN_MODE=LOCAL_DEV
CREDENCE_ENVIRONMENT=sandbox
CREDENCE_DATABASE_URL=postgresql+psycopg://credence:credence@localhost:5432/credence
CREDENCE_OPA_URL=http://localhost:8181

# Local AI via Ollama (no API keys; fully local inference)
CREDENCE_MODEL_PROVIDER=ollama            # ollama | disabled
CREDENCE_OLLAMA_BASE_URL=http://localhost:11434
CREDENCE_OLLAMA_ANALYST_MODEL=qwen3:1.7b
CREDENCE_OLLAMA_CRITIC_MODEL=mistral-small3.2:24b
CREDENCE_OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
CREDENCE_MODEL_TIMEOUT_SECONDS=120

# Demo endpoints bearer token (sandbox only)
CREDENCE_DEMO_RESET_TOKEN=change-me

# Voice stays disabled unless explicitly configured
CREDENCE_VOICE_PROVIDER=disabled
# ELEVENLABS_API_KEY=

# GCP context (no keys — gcloud ADC / Workload Identity only)
GOOGLE_CLOUD_PROJECT=innova-hack
GOOGLE_CLOUD_REGION=asia-south1
