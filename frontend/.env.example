# Copy to .env.local and adjust. Real values never belong in version control.
#
# Every variable here is server-only on purpose. A NEXT_PUBLIC_ prefix would
# inline the value into the JavaScript bundle, which for a token means shipping
# a credential to every visitor. The browser reaches the API through the proxy
# at /api/credence, which attaches credentials server-side.

# Where the FastAPI service listens.
CREDENCE_API_BASE=http://127.0.0.1:8001

# Token guarding the backend's sandbox demo surface. Must match
# CREDENCE_DEMO_RESET_TOKEN in the repository-root .env. Empty disables the
# Judge Demo page, which is the correct default outside a sandbox.
CREDENCE_DEMO_TOKEN=
